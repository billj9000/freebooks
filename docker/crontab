MAILTO=""
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# FreeBooks scheduled tasks
# Output is written to the container's stdout, so it appears in docker logs.
#
# Only tasks for code this image contains belong here. An image built FROM this
# one adds its own as a further file in /etc/cron.d/ - the Zen Cart order import,
# for one, needs the zencart extension, which this image does not include.
# The PATH above applies to this file only, so such a file names PHP as
# /usr/local/bin/php.

# Currency rate update — runs daily at 1:00am from ECB feed.
0 1 * * * root php /var/www/html/cron/update_currency_rates.php >> /proc/1/fd/1 2>&1

