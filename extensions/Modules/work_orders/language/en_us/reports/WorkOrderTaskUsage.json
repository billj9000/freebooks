{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Work Order Task Usage",
    "description": "This report list the work order grouped by task.",
    "group": "inv",
    "dataset": "work_orders",
    "page": {
        "size": "Letter",
        "orientation": "P",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "report": {
        "columns": [
            {
                "key": "task_name",
                "heading": "Task Name",
                "width": 50,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "wo_title",
                "heading": "WO Title",
                "width": 64,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "step_number",
                "heading": "WO Step",
                "width": 25,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "wo_revision",
                "heading": "WO Revision",
                "width": 10,
                "align": "C",
                "pageBreak": true
            }
        ],
        "groupBy": "task_id",
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
