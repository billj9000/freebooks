{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Work Order List",
    "description": "Lists active work orders",
    "group": "inv",
    "dataset": "work_orders",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "a"
    },
    "filters": [
        {
            "field": "wo_inactive",
            "operator": "eq",
            "values": [
                "0"
            ]
        }
    ],
    "report": {
        "columns": [
            {
                "key": "wo_title",
                "heading": "WO Title",
                "width": 80,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "sku",
                "heading": "SKU",
                "width": 30,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "wo_description",
                "heading": "Description",
                "width": 90,
                "align": "L",
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title2": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
