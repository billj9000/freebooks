{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Aged Payables Summary",
    "description": "Lists Aged Payables in summary format. Format: Landscape, Size: Letter",
    "group": "vend",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "a",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "closed",
            "operator": "eq",
            "values": [
                "0"
            ]
        },
        {
            "field": "journal_id",
            "operator": "in",
            "values": [
                "6",
                "7"
            ]
        }
    ],
    "sorts": [
        {
            "field": "bill_primary_name",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "bill_primary_name",
                "heading": "Vendor",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "bill_telephone1",
                "heading": "Telephone",
                "width": 50,
                "align": "L"
            },
            {
                "key": "bill_contact",
                "heading": "Contact",
                "width": 50,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "contact_short_name",
                "heading": "Vendor ID",
                "width": 30,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "balance_0",
                "heading": "Current",
                "width": 25,
                "align": "R",
                "format": "null_dcur",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "balance_30",
                "heading": "31-60",
                "width": 25,
                "align": "R",
                "format": "null_dcur",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "balance_60",
                "heading": "61-90",
                "width": 25,
                "align": "R",
                "format": "null_dcur",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "balance_90",
                "heading": "Over 90",
                "width": 25,
                "align": "R",
                "format": "null_dcur",
                "total": true,
                "pageBreak": true
            }
        ],
        "groupBy": "bill_acct_id",
        "totalsOnly": true,
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
