{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Customer Invoice History",
    "description": "Shows the sales/invoice of the customer database. Report size: Letter, Portrait.",
    "group": "cust",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "f",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "journal_id",
            "operator": "in",
            "values": [
                "12",
                "13"
            ]
        },
        {
            "field": "item_gl_type",
            "operator": "eq",
            "values": [
                "ttl"
            ]
        }
    ],
    "sorts": [
        {
            "field": "post_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "period",
                "heading": "Period",
                "width": 15,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "bill_primary_name",
                "heading": "Customer Name",
                "width": 65,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "post_date",
                "heading": "Invoice Date",
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "closed",
                "heading": "Paid",
                "width": 15,
                "align": "L",
                "format": "yesBno",
                "pageBreak": true
            },
            {
                "key": "purch_order_id",
                "heading": "Purchase Order",
                "width": 40,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_net_debit",
                "heading": "Invoice Total",
                "width": 25,
                "align": "R",
                "format": "def_cur",
                "total": true,
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
