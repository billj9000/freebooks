{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Sales Report",
    "description": "Lists sales for a given period. Format: Letter, Portrait",
    "group": "cust",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "c",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "journal_id",
            "operator": "in",
            "values": [
                "12",
                "13"
            ]
        },
        {
            "field": "item_gl_type",
            "operator": "eq",
            "values": [
                "ttl"
            ]
        }
    ],
    "sorts": [
        {
            "field": "purchase_invoice_id",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "post_date",
                "heading": "Post Date",
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "purchase_invoice_id",
                "heading": "Inv Number",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "purch_order_id",
                "heading": "Customer PO Number",
                "width": 50,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "bill_primary_name",
                "heading": "Sold To",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_net_debit",
                "heading": "Invoice Amount",
                "width": 30,
                "align": "R",
                "format": "def_cur",
                "total": true,
                "pageBreak": true
            }
        ],
        "groupBy": "post_date",
        "groupFormat": "0",
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
