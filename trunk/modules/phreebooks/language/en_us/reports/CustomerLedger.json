{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Customer Ledger",
    "description": "Shows the customer ledger, sales, credits, payments. Report size: Letter, Landscape.",
    "group": "cust",
    "filenamePrefix": "gl-",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "f",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "contact_type",
            "operator": "eq",
            "values": [
                "c"
            ]
        }
    ],
    "sorts": [
        {
            "field": "post_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "post_date",
                "heading": "Post Date",
                "width": 22,
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "journal_id",
                "heading": "Journal ID",
                "width": 45,
                "align": "L",
                "format": "j_desc",
                "pageBreak": true
            },
            {
                "key": "bill_primary_name",
                "heading": "Customer Name",
                "width": 65,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "purchase_invoice_id",
                "heading": "Reference",
                "width": 30,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "purch_order_id",
                "heading": "Customer Ref",
                "width": 30,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_gl_account",
                "heading": "GL Acct",
                "width": 20,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_debit",
                "heading": "Debit Amount",
                "width": 25,
                "align": "R",
                "format": "null_pcur",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "item_credit",
                "heading": "Credit Amount",
                "width": 25,
                "align": "R",
                "format": "null_pcur",
                "total": true,
                "pageBreak": true
            }
        ],
        "groupBy": "bill_acct_id_name",
        "resolved": {
            "bill_acct_id_name": "bill_acct_id"
        },
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
