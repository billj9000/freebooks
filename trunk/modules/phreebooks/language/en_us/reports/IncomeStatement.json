{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Income Statement",
    "description": "General ledger Income statement. Format: Letter, Portrait. Requires special report: income_statement.",
    "group": "gl",
    "provider": "is_budget",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 10,
            "bottom": 10,
            "left": 10,
            "right": 10
        }
    },
    "dates": {
        "default": "a"
    },
    "report": {
        "columns": [
            {
                "key": "description",
                "heading": "Account",
                "width": 75,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "current",
                "heading": "Current Period",
                "width": 60,
                "align": "R",
                "format": "def_cur",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "current_ytd",
                "heading": "Year to Date",
                "width": 60,
                "align": "R",
                "format": "def_cur",
                "total": true,
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    255
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    255,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated on %date%"
        }
    }
}
