{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "General Ledger",
    "description": "Lists general ledger activities. Format: Letter, Portrait",
    "group": "gl",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 12,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "l",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "journal_id",
            "operator": "in",
            "values": [
                "2",
                "6",
                "7",
                "12",
                "13",
                "14",
                "16",
                "18",
                "20"
            ]
        }
    ],
    "sorts": [
        {
            "field": "post_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "id",
                "heading": "Record",
                "width": 14,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "period",
                "heading": "Period",
                "width": 14,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "post_date",
                "heading": "Post Date",
                "width": 20,
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "item_gl_account",
                "heading": "Account",
                "width": 20,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_description",
                "heading": "Description",
                "width": 82,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_debit",
                "heading": "Debit Amount",
                "align": "R",
                "format": "null_pcur",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "item_credit",
                "heading": "Credit Amount",
                "align": "R",
                "format": "null_pcur",
                "total": true,
                "pageBreak": true
            }
        ],
        "groupBy": "item_gl_account",
        "groupFormat": "0",
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%",
            "truncate": true
        }
    }
}
