{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Balance Sheet",
    "description": "General Ledger Balance Sheet. Format: Letter, Portrait. Requires special report: balance_sheet.",
    "group": "gl",
    "provider": "balance_sheet",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 10,
            "bottom": 10,
            "left": 10,
            "right": 10
        }
    },
    "dates": {
        "default": "a"
    },
    "report": {
        "columns": [
            {
                "key": "c0",
                "heading": "Description",
                "width": 75,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "c1",
                "heading": "Value",
                "width": 35,
                "align": "R",
                "format": "posted_cur",
                "pageBreak": true
            },
            {
                "key": "c2",
                "heading": "Sub-total",
                "width": 35,
                "align": "R",
                "format": "posted_cur",
                "pageBreak": true
            },
            {
                "key": "c3",
                "heading": "Total",
                "width": 35,
                "align": "R",
                "format": "posted_cur",
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    255
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    255,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
