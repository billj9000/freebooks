{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Open Sales Orders",
    "description": "Lists unfilled sales orders. Format: Letter, Portrait",
    "group": "cust",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "P",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "l",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "closed",
            "operator": "eq",
            "values": [
                "0"
            ]
        },
        {
            "field": "journal_id",
            "operator": "eq",
            "values": [
                "10"
            ]
        }
    ],
    "sorts": [
        {
            "field": "post_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "purchase_invoice_id",
                "heading": "PO Number",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "post_date",
                "heading": "Post Date",
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "purch_order_id",
                "heading": "Customer PO Number",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "bill_primary_name",
                "heading": "Sold To",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "total_amount",
                "heading": "PO Total",
                "width": 25,
                "align": "R",
                "format": "posted_cur",
                "total": true,
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
