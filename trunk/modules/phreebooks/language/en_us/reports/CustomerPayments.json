{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Customer Payments",
    "description": "Lists the customer payments. Format: Letter, Landscape",
    "group": "bnk",
    "filenamePrefix": "DP-",
    "dataset": "transactions",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "c",
        "field": "post_date"
    },
    "filters": [
        {
            "field": "journal_id",
            "operator": "in",
            "values": [
                "18",
                "21"
            ]
        }
    ],
    "sorts": [
        {
            "field": "post_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "post_date",
                "heading": "Post Date",
                "width": 25,
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "bill_primary_name",
                "heading": "Customer Name",
                "width": 80,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "shipper_code",
                "heading": "Payment Method",
                "width": 25,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "purchase_invoice_id",
                "heading": "Deposit Number",
                "width": 40,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "total_amount",
                "heading": "Amount Paid",
                "width": 25,
                "align": "R",
                "format": "posted_cur",
                "total": true,
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
