{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Inventory Re-order Worksheet",
    "description": "Lists inventory items needed for re-order. Format: Letter, Landscape",
    "group": "inv",
    "dataset": "inventory",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "a"
    },
    "filters": [
        {
            "field": "qty_stock",
            "operator": "lt",
            "expression": [
                {
                    "kind": "op",
                    "text": "("
                },
                {
                    "kind": "field",
                    "text": "min_stock_level"
                },
                {
                    "kind": "op",
                    "text": "+"
                },
                {
                    "kind": "field",
                    "text": "qty_on_sales"
                },
                {
                    "kind": "op",
                    "text": "-"
                },
                {
                    "kind": "field",
                    "text": "qty_on_order"
                },
                {
                    "kind": "op",
                    "text": ")"
                }
            ]
        }
    ],
    "sorts": [
        {
            "field": "sku",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "sku",
                "heading": "SKU Number",
                "width": 29,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_description",
                "heading": "Description Short",
                "width": 56,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "min_stock_level",
                "heading": "Min Stock",
                "width": 19,
                "align": "C",
                "pageBreak": true
            },
            {
                "key": "qty_stock",
                "heading": "In Stock",
                "width": 16,
                "align": "C",
                "pageBreak": true
            },
            {
                "key": "qty_on_order",
                "heading": "On Order",
                "width": 16,
                "align": "C",
                "pageBreak": true
            },
            {
                "key": "qty_on_sales",
                "heading": "On SO",
                "width": 15,
                "align": "C",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "reorder_quantity",
                "heading": "Reorder",
                "width": 16,
                "align": "C",
                "pageBreak": true
            },
            {
                "key": "vendor_id_name",
                "heading": "Vendor",
                "width": 33,
                "align": "L",
                "pageBreak": true
            }
        ],
        "groupBy": "vendor_id",
        "groupFormat": "0",
        "resolved": {
            "vendor_id_name": "vendor_id"
        },
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%",
            "truncate": true
        }
    }
}
