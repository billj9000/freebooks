{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Inventory List",
    "description": "Lists inventory items. Format: Letter, Landscape",
    "group": "inv",
    "dataset": "inventory",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 10,
            "bottom": 10,
            "left": 10,
            "right": 10
        }
    },
    "dates": {
        "default": "a"
    },
    "sorts": [
        {
            "field": "sku",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "item_description",
                "heading": "Description Short",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "sku",
                "heading": "SKU Number",
                "width": 35,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "qty_stock",
                "heading": "In Stock",
                "width": 25,
                "align": "C",
                "pageBreak": true
            },
            {
                "key": "account_inventory",
                "heading": "Inv. Acct",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "item_cost",
                "heading": "Item Cost",
                "align": "R",
                "format": "rnd2d",
                "pageBreak": true
            },
            {
                "key": "full_price",
                "heading": "Full Price",
                "align": "R",
                "format": "rnd2d",
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
