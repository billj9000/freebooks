{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Inventory Aging - Average Cost",
    "description": "Inventory aging report. Format Letter, Landscape.",
    "group": "inv",
    "dataset": "inventory",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "a"
    },
    "filters": [
        {
            "field": "history_remaining",
            "operator": "ne",
            "values": [
                "0"
            ]
        }
    ],
    "sorts": [
        {
            "field": "history_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "history_sku",
                "heading": "SKU",
                "width": 35,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "history_date",
                "heading": "Purchase Date",
                "width": 30,
                "align": "L",
                "format": "date",
                "pageBreak": true
            },
            {
                "key": "history_remaining",
                "heading": "Qty",
                "width": 15,
                "align": "R",
                "total": true,
                "pageBreak": true
            },
            {
                "key": "item_description",
                "heading": "Description",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "history_unit_cost",
                "heading": "Unit Cost",
                "width": 26,
                "align": "R",
                "format": "rnd2d",
                "pageBreak": true
            },
            {
                "key": "history_sku_avg_cost",
                "heading": "Average Cost",
                "width": 25,
                "align": "R",
                "pageBreak": true
            },
            {
                "key": "history_id_avg_total",
                "heading": "Total Value",
                "width": 30,
                "align": "R",
                "total": true,
                "pageBreak": true
            }
        ],
        "groupBy": "history_sku",
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%"
        }
    }
}
