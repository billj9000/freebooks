{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Audit Log",
    "description": "User audit log. Captures all activities by users. format: Letter, Landscape",
    "group": "misc",
    "dataset": "audit_trail",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 12,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "c",
        "field": "log_date"
    },
    "sorts": [
        {
            "field": "log_date",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "user_name",
                "heading": "User",
                "width": 15,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "log_date",
                "heading": "Date",
                "width": 40,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "log_action",
                "heading": "Action",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "log_ref",
                "heading": "Reference",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "log_amount",
                "heading": "Amount",
                "align": "R",
                "format": "null_pcur"
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Report Generated %date%",
            "truncate": true
        }
    }
}
