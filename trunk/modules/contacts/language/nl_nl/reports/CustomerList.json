{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Lijst met Klanten",
    "description": "Lijst met adres informatie. formaat: Letter, Portrait",
    "group": "cust",
    "dataset": "contacts",
    "page": {
        "size": "Letter",
        "orientation": "L",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "a"
    },
    "filters": [
        {
            "field": "address_type",
            "operator": "eq",
            "values": [
                "cm"
            ]
        }
    ],
    "sorts": [
        {
            "field": "short_name",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "primary_name",
                "heading": "Naam vd Klant",
                "width": 60,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "short_name",
                "heading": "Klant ID",
                "width": 40,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "address1",
                "heading": "Adres 1",
                "width": 50,
                "align": "L"
            },
            {
                "key": "address2",
                "heading": "Adres 2",
                "width": 50,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "city_town",
                "heading": "Plaats",
                "width": 35,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "state_province",
                "heading": "Staat",
                "width": 25,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "postal_code",
                "heading": "Postcode",
                "width": 25,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "country_code",
                "heading": "Land",
                "width": 15,
                "align": "L",
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Rapport Gegenereerd op %date%"
        }
    }
}
