{
    "format": "freebooks/forms-definition",
    "version": 1,
    "type": "rpt",
    "title": "Personeels Lijst",
    "description": "Lijst met adres informatie van Personeel. formaat: Letter, Portrait",
    "group": "hr",
    "dataset": "contacts",
    "page": {
        "size": "Letter",
        "orientation": "P",
        "margins": {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
        }
    },
    "dates": {
        "default": "a"
    },
    "filters": [
        {
            "field": "address_type",
            "operator": "eq",
            "values": [
                "em"
            ]
        }
    ],
    "sorts": [
        {
            "field": "last_name",
            "direction": "ASC"
        }
    ],
    "report": {
        "columns": [
            {
                "key": "first_name",
                "heading": "Voornaam",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "last_name",
                "heading": "Achternaam",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "telephone1",
                "heading": "Telefoon 1",
                "width": 25,
                "align": "L"
            },
            {
                "key": "telephone2",
                "heading": "Telefoon 2",
                "width": 25,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "email",
                "heading": "Email",
                "width": 45,
                "align": "L"
            },
            {
                "key": "gov_id_number",
                "heading": "BSN Nummer",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "address1",
                "heading": "Adres 1",
                "width": 40,
                "align": "L"
            },
            {
                "key": "address2",
                "heading": "Adres 2",
                "width": 40,
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "city_town",
                "heading": "Plaats",
                "width": 25,
                "align": "L"
            },
            {
                "key": "state_province",
                "heading": "Staat",
                "align": "L",
                "pageBreak": true
            },
            {
                "key": "postal_code",
                "heading": "Postcode",
                "width": 15,
                "align": "L",
                "pageBreak": true
            }
        ],
        "style": {
            "heading": {
                "font": "helvetica",
                "size": 12,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title1": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "title2": {
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "C"
            },
            "filter": {
                "font": "helvetica",
                "size": 8,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "data": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "totals": {
                "font": "helvetica",
                "size": 10,
                "colour": [
                    0,
                    0,
                    0
                ],
                "align": "L"
            },
            "title1Text": "%reportname%",
            "title2Text": "Rapport Gegenereerd op %date%"
        }
    }
}
